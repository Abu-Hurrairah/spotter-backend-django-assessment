{
  "info": {
    "name": "Spotter Fuel Route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"}
  ],
  "item": [
    {
      "name": "Health",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/health/"}
    },
    {
      "name": "Data Status",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/data/status/"}
    },
    {
      "name": "Optimize Route",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Chicago, IL\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/route/"
      }
    }
  ]
}
